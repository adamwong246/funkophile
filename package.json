{
  "name": "funkophile",
  "version": "0.5.0",
  "repository": "git@github.com:adamwong246/funkophile.git",
  "author": "adam wong <adamwong246@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/adamwong246/funkophile",
  "keywords": [
    "static site generator"
  ],
  "type": "module",
  "test": "mocha",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "mocha": {
    "node-option": [
      "import=tsx"
    ]
  },
  "scripts": {
    "transpile": "tsc --project tsconfig.json > tsc.log",
    "test": "mocha --loader=ts '**/*.test.ts'",
    "test:watch": "mocha --loader=ts  --watch '**/*.test.ts'",
    "test:ci": "mocha -r ts-node/register '**/*.test.ts' --reporter mocha-junit-reporter",
    "do_it": "yarn test &> mocha.log; yarn tsc --noEmit &> tsc.log; yarn transpile"
  },
  "dependencies": {
    "@tsconfig/node-lts-strictest-esm": "^18.12.1",
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^5.2.2",
    "@types/chokidar": "^2.1.7",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/redux": "^3.6.0",
    "@types/reselect": "^2.2.0",
    "bluebird": "3.7.2",
    "chai": "^5.2.1",
    "fs-extra": "^11.3.0",
    "glob": "11.0.1",
    "mocha": "^11.7.1",
    "mocha-junit-reporter": "^2.2.0",
    "ts-node": "^10.9.1",
    "tsc": "^2.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/esm/index.js"
      },
      "default": "./dist/esm/index.js"
    }
  }
}
