{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "outDir": "dist/esm",
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "rootDir": ".",
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "emitDeclarationOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "funkophileHelpers.ts",
    "utils.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
